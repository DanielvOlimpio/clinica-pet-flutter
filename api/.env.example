# Copie este arquivo para .env e preencha com os SEUS valores locais.
# O arquivo .env NAO deve ser enviado ao Git.

# Opcao 1: string de conexao completa (usada pelo Render / servicos gerenciados)
DATABASE_URL=postgres://usuario:senha@localhost:5432/clinica_pet

# Opcao 2 (desenvolvimento local sem DATABASE_URL): variaveis separadas
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=senha_do_postgres_local
PGDATABASE=clinica_pet

# Porta onde a API escuta (o Render define PORT automaticamente)
PORT=3000
